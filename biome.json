{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      ".vscode/*.json",
      "libs/typescript/**/*.js",
      "libs/typescript/**/*.jsx",
      "libs/typescript/**/*.ts",
      "libs/typescript/**/*.tsx",
      "libs/typescript/**/package.json",
      "package.json",
      "!libs/typescript/*/dist/native/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "lineWidth": 100,
    "useEditorconfig": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "jsxQuoteStyle": "double",
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
