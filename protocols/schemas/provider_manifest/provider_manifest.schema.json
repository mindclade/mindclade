{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://mindclade.dev/schemas/provider-manifest/v1","title":"ProviderManifest","type":"object","additionalProperties":false,"required":["schema_version","kind","metadata","spec","lineage","integrity"],"properties":{"schema_version":{"const":"mindclade.provider-manifest/v1"},"kind":{"const":"ProviderManifest"},"metadata":{"$ref":"#/$defs/metadata"},"spec":{"type":"object","additionalProperties":false,"required":["provider_id","provider_version","source_revision","capabilities","configuration_schema","qualification","qualification_verified"],"properties":{"provider_id":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{0,63}$"},"provider_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"source_revision":{"$ref":"#/$defs/digest"},"capabilities":{"type":"array","minItems":1,"maxItems":128,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{0,63}$"}},"configuration_schema":{"$ref":"#/$defs/artifact_ref"},"qualification":{"$ref":"#/$defs/artifact_ref"},"qualification_verified":{"const":true}}},"lineage":{"type":"array","minItems":1,"maxItems":32,"items":{"$ref":"#/$defs/artifact_ref"}},"integrity":{"$ref":"#/$defs/integrity"}},"$defs":{"digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"metadata":{"type":"object","additionalProperties":false,"required":["uid","created_at","producer","classification"],"properties":{"uid":{"type":"string","minLength":1,"maxLength":128},"created_at":{"type":"string","format":"date-time"},"producer":{"type":"string","minLength":1,"maxLength":128},"classification":{"enum":["PUBLIC","INTERNAL","RESTRICTED"]}}},"artifact_ref":{"type":"object","additionalProperties":false,"required":["uri","digest","media_type","schema_version"],"properties":{"uri":{"type":"string","pattern":"^artifacts/[A-Za-z0-9._~/-]+$"},"digest":{"$ref":"#/$defs/digest"},"media_type":{"type":"string","minLength":1,"maxLength":128},"schema_version":{"type":"string","minL