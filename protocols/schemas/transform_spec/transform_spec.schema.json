{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://mindclade.dev/schemas/transform-spec/v1","title":"TransformSpec","type":"object","additionalProperties":false,"required":["schema_version","kind","metadata","spec","lineage","integrity"],"properties":{"schema_version":{"const":"mindclade.transform-spec/v1"},"kind":{"const":"TransformSpec"},"metadata":{"$ref":"#/$defs/metadata"},"spec":{"type":"object","additionalProperties":false,"required":["transform_type","input_schema_digest","output_schema_digest","state_mode","state_contract","parameters"],"properties":{"transform_type":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{0,127}$"},"input_schema_digest":{"$ref":"#/$defs/digest"},"output_schema_digest":{"$ref":"#/$defs/digest"},"state_mode":{"enum":["STATELESS","FITTED"]},"state_contract":{"enum":["NONE","DECLARED_ARTIFACT"]},"parameters":{"type":"object","maxProperties":64,"propertyNames":{"pattern":"^(?!.*(?:secret|token|password|credential))[a-z][a-z0-9_]{0,63}$"},"additionalProperties":{"type":["string","number","integer","boolean"]}}}},"lineage":{"type":"array","maxItems":32,"items":{"$ref":"#/$defs/artifact_ref"}},"integrity":{"$ref":"#/$defs/integrity"}},"$defs":{"digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"metadata":{"type":"object","additionalProperties":false,"required":["uid","created_at","producer","classification"],"properties":{"uid":{"type":"string","minLength":1,"maxLength":128},"created_at":{"type":"string","format":"date-time"},"producer":{"type":"string","minLength":1,"maxLength":128},"classification":{"enum":["PUBLIC","INTERNAL","RESTRICTED"]}}},"artifact_ref":{"type":"object","additionalProperties":false,"required":["uri","digest","media_type","schema_version"],"properties":{"uri":{"type":"string","pattern":"^artifacts/[A-Za-z0-9._~/-]+$"},"digest":{"$ref":"#/$defs/digest"},"media_type":{"type":"string","minLength":1,"maxLength":128},"schema_version":{"type":"string","minLength":1,"maxLength":128}}},"integrit