{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://mindclade.dev/schemas/model-manifest/v1","title":"ModelManifest","type":"object","additionalProperties":false,"required":["schema_version","kind","metadata","spec","lineage","integrity"],"properties":{"schema_version":{"const":"mindclade.model-manifest/v1"},"kind":{"const":"ModelManifest"},"metadata":{"$ref":"#/$defs/metadata"},"spec":{"type":"object","additionalProperties":false,"required":["model_name","architecture","checkpoint","checkpoint_verified","feature_requirements","evaluation","intended_use","uncertainty_disclosure"],"properties":{"model_name":{"type":"string","minLength":1,"maxLength":128},"architecture":{"$ref":"#/$defs/artifact_ref"},"checkpoint":{"$ref":"#/$defs/artifact_ref"},"checkpoint_verified":{"const":true},"feature_requirements":{"$ref":"#/$defs/artifact_ref"},"evaluation":{"$ref":"#/$defs/artifact_ref"},"intended_use":{"const":"NON_CLINICAL_RESEARCH"},"uncertainty_disclosure":{"type":"string","minLength":1,"maxLength":1024}}},"lineage":{"type":"array","minItems":3,"maxItems":64,"items":{"$ref":"#/$defs/artifact_ref"}},"integrity":{"$ref":"#/$defs/integrity"}},"$defs":{"digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"metadata":{"type":"object","additionalProperties":false,"required":["uid","created_at","producer","classification"],"properties":{"uid":{"type":"string","minLength":1,"maxLength":128},"created_at":{"type":"string","format":"date-time"},"producer":{"type":"string","minLength":1,"maxLength":128},"classification":{"enum":["PUBLIC","INTERNAL","RESTRICTED"]}}},"artifact_ref":{"type":"object","additionalProperties":false,"required":["uri","digest","media_type","schema_version"],"properties":{"uri":{"type":"string","pattern":"^artifacts/[A-Za-z0-9._~/-]+$"},"digest":{"$ref":"#/$defs/digest"},"media_type":{"type":"string","minLength":1,"maxLength":128},"schema_version":{"type":"string","minLength":1,"maxLength":128}}},"integrity":{"type":"object","additi