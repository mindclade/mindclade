{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://mindclade.dev/schemas/development-kit-assembly/v1","title":"DevelopmentKitAssembly","type":"object","additionalProperties":false,"required":["schema_version","kind","metadata","spec","lineage","integrity"],"properties":{"schema_version":{"const":"mindclade.development-kit-assembly/v1"},"kind":{"const":"DevelopmentKitAssembly"},"metadata":{"$ref":"#/$defs/metadata"},"spec":{"type":"object","additionalProperties":false,"required":["assembly_name","source_authority","source_revision","components","lockfile_digests","sbom","provenance","qualification","intended_use"],"properties":{"assembly_name":{"type":"string","minLength":1,"maxLength":128},"source_authority":{"const":"github.com/mindclade/mindclade"},"source_revision":{"type":"string","pattern":"^[0-9a-f]{40}$"},"components":{"type":"array","minItems":1,"maxItems":256,"items":{"$ref":"#/$defs/artifact_ref"}},"lockfile_digests":{"type":"array","minItems":1,"maxItems":64,"uniqueItems":true,"items":{"$ref":"#/$defs/digest"}},"sbom":{"$ref":"#/$defs/artifact_ref"},"provenance":{"$ref":"#/$defs/artifact_ref"},"qualification":{"$ref":"#/$defs/artifact_ref"},"intended_use":{"const":"NON_CLINICAL_RESEARCH"}}},"lineage":{"type":"array","minItems":3,"maxItems":128,"items":{"$ref":"#/$defs/artifact_ref"}},"integrity":{"$ref":"#/$defs/integrity"}},"$defs":{"digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"metadata":{"type":"object","additionalProperties":false,"required":["uid","created_at","producer","classification"],"properties":{"uid":{"type":"string","minLength":1,"maxLength":128},"created_at":{"type":"string","format":"date-time"},"producer":{"type":"string","minLength":1,"maxLength":128},"classification":{"enum":["PUBLIC","INTERNAL","RESTRICTED"]}}},"artifact_ref":{"type":"object","additionalProperties":false,"required":["uri","digest","media_type","schema_version"],"properties":{"uri":{"type":"string","pattern":"^artifacts/[A-Za-z0-9._~