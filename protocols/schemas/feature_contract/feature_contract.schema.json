{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://mindclade.dev/schemas/feature-contract/v1","title":"FeatureContract","type":"object","additionalProperties":false,"required":["schema_version","kind","metadata","spec","lineage","integrity"],"properties":{"schema_version":{"const":"mindclade.feature-contract/v1"},"kind":{"const":"FeatureContract"},"metadata":{"$ref":"#/$defs/metadata"},"spec":{"type":"object","additionalProperties":false,"required":["semantic_identity","value_type","shape","units","coordinate_frame","nullable","provenance","use_classification"],"properties":{"semantic_identity":{"type":"string","pattern":"^feature/[a-z][a-z0-9_.-]{0,95}@v[1-9][0-9]*$"},"value_type":{"enum":["FLOAT32","FLOAT64","INT32","INT64","BOOL","STRING"]},"shape":{"type":"array","minItems":1,"maxItems":8,"items":{"type":"integer","minimum":-1,"maximum":1048576}},"units":{"type":"string","minLength":1,"maxLength":64},"coordinate_frame":{"type":"string","minLength":1,"maxLength":64},"nullable":{"type":"boolean"},"provenance":{"$ref":"#/$defs/artifact_ref"},"use_classification":{"const":"NON_CLINICAL_RESEARCH"}}},"lineage":{"type":"array","maxItems":32,"items":{"$ref":"#/$defs/artifact_ref"}},"integrity":{"$ref":"#/$defs/integrity"}},"$defs":{"digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"metadata":{"type":"object","additionalProperties":false,"required":["uid","created_at","producer","classification"],"properties":{"uid":{"type":"string","minLength":1,"maxLength":128},"created_at":{"type":"string","format":"date-time"},"producer":{"type":"string","minLength":1,"maxLength":128},"classification":{"enum":["PUBLIC","INTERNAL","RESTRICTED"]}}},"artifact_ref":{"type":"object","additionalProperties":false,"required":["uri","digest","media_type","schema_version"],"properties":{"uri":{"type":"string","pattern":"^artifacts/[A-Za-z0-9._~/-]+$"},"digest":{"$ref":"#/$defs/digest"},"media_type":{"type":"string","minLength":1,"maxLength":128},"schema_version