{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://mindclade.dev/schemas/agent-definition/v1","title":"AgentDefinition","type":"object","additionalProperties":false,"required":["schema_version","kind","metadata","spec","lineage","integrity"],"properties":{"schema_version":{"const":"mindclade.agent-definition/v1"},"kind":{"const":"AgentDefinition"},"metadata":{"$ref":"#/$defs/metadata"},"spec":{"type":"object","additionalProperties":false,"required":["agent_name","model","tool_contracts","capabilities","risk_classification","safety_review","network_access","intended_use","uncertainty_disclosure"],"properties":{"agent_name":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{0,63}$"},"model":{"$ref":"#/$defs/artifact_ref"},"tool_contracts":{"type":"array","minItems":1,"maxItems":64,"items":{"$ref":"#/$defs/artifact_ref"}},"capabilities":{"type":"array","minItems":1,"maxItems":32,"uniqueItems":true,"items":{"enum":["READ_ARTIFACT","SUBMIT_JOB","QUERY_STATUS","RECORD_APPROVAL"]}},"risk_classification":{"enum":["LOW","MODERATE","REVIEW_REQUIRED"]},"safety_review":{"$ref":"#/$defs/artifact_ref"},"network_access":{"const":false},"intended_use":{"const":"NON_CLINICAL_RESEARCH"},"uncertainty_disclosure":{"type":"string","minLength":1,"maxLength":1024}}},"lineage":{"type":"array","minItems":2,"maxItems":64,"items":{"$ref":"#/$defs/artifact_ref"}},"integrity":{"$ref":"#/$defs/integrity"}},"$defs":{"digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"metadata":{"type":"object","additionalProperties":false,"required":["uid","created_at","producer","classification"],"properties":{"uid":{"type":"string","minLength":1,"maxLength":128},"created_at":{"type":"string","format":"date-time"},"producer":{"type":"string","minLength":1,"maxLength":128},"classification":{"enum":["PUBLIC","INTERNAL","RESTRICTED"]}}},"artifact_ref":{"type":"object","additionalProperties":false,"required":["uri","digest","media_type","schema_version"],"properties":{"uri":{"type":"string","pattern":"^artifacts/[A-Za-z0-9._~/-]+$"},"digest":{"$ref":"#/$defs/digest"},"media_type":{"type":"string","minLength":1,"maxLength":128},"schema_version":{"type":"string","minLength":1,"maxLength":128}}},"integrity":{"type":"object","additionalProperties":false,"required":["payload_digest"],"properties":{"payload_digest":{"$ref":"#/$defs/digest"},"evidence":{"type":"array","maxItems":32,"items":{"$ref":"#/$defs/artifact_ref"}}}}}}
