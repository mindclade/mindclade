{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://mindclade.dev/schemas/checkpoint-manifest/v1","title":"CheckpointManifest","type":"object","additionalProperties":false,"required":["schema_version","kind","metadata","spec","lineage","integrity"],"properties":{"schema_version":{"const":"mindclade.checkpoint-manifest/v1"},"kind":{"const":"CheckpointManifest"},"metadata":{"$ref":"#/$defs/metadata"},"spec":{"type":"object","additionalProperties":false,"required":["run","global_step","weights","optimizer_state","logical_state_schema","logical_state","logical_state_verified","deterministic_resume"],"properties":{"run":{"type":"string","pattern":"^tenants/[A-Za-z0-9._~-]+/projects/[A-Za-z0-9._~-]+/trainingRuns/[A-Za-z0-9._~-]+$"},"global_step":{"type":"integer","minimum":0},"weights":{"$ref":"#/$defs/artifact_ref"},"optimizer_state":{"$ref":"#/$defs/artifact_ref"},"logical_state_schema":{"$ref":"#/$defs/artifact_ref"},"logical_state":{"$ref":"#/$defs/artifact_ref"},"logical_state_verified":{"const":true},"deterministic_resume":{"const":true}}},"lineage":{"type":"array","minItems":2,"maxItems":64,"items":{"$ref":"#/$defs/artifact_ref"}},"integrity":{"$ref":"#/$defs/integrity"}},"$defs":{"digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"metadata":{"type":"object","additionalProperties":false,"required":["uid","created_at","producer","classification"],"properties":{"uid":{"type":"string","minLength":1,"maxLength":128},"created_at":{"type":"string","format":"date-time"},"producer":{"type":"string","minLength":1,"maxLength":128},"classification":{"enum":["PUBLIC","INTERNAL","RESTRICTED"]}}},"artifact_ref":{"type":"object","additionalProperties":false,"required":["uri","digest","media_type","schema_version"],"properties":{"uri":{"type":"string","pattern":"^artifacts/[A-Za-z0-9._~/-]+$"},"digest":{"$ref":"#/$defs/digest"},"media_type":{"type":"string","minLength":1,"maxLength":128},"schema_version":{"type":"string","minLength":1,"maxLength":128}}},"integrity":{"type":"object","additionalProperties":false,"required":["payload_digest"],"properties":{"payload_digest":{"$ref":"#/$defs/digest"},"evidence":{"type":"array","maxItems":32,"items":{"$ref":"#/$defs/artifact_ref"}}}}}}
