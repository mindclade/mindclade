{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://mindclade.dev/schemas/tool-contract/v1","title":"ToolContract","type":"object","additionalProperties":false,"required":["schema_version","kind","metadata","spec","lineage","integrity"],"properties":{"schema_version":{"const":"mindclade.tool-contract/v1"},"kind":{"const":"ToolContract"},"metadata":{"$ref":"#/$defs/metadata"},"spec":{"type":"object","additionalProperties":false,"required":["tool_id","tool_version","input_schema","output_schema","permissions","side_effect_class","approval_required","max_duration_seconds","receipt_required"],"properties":{"tool_id":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{0,63}$"},"tool_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"input_schema":{"$ref":"#/$defs/artifact_ref"},"output_schema":{"$ref":"#/$defs/artifact_ref"},"permissions":{"type":"array","minItems":1,"maxItems":16,"uniqueItems":true,"items":{"enum":["artifact.read","job.submit","job.status.read","approval.record"]}},"side_effect_class":{"enum":["READ_ONLY","DURABLE_JOB","APPROVAL_RECORD"]},"approval_required":{"type":"boolean"},"max_duration_seconds":{"type":"integer","minimum":1,"maximum":3600},"receipt_required":{"const":true}}},"lineage":{"type":"array","minItems":2,"maxItems":32,"items":{"$ref":"#/$defs/artifact_ref"}},"integrity":{"$ref":"#/$defs/integrity"}},"$defs":{"digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"metadata":{"type":"object","additionalProperties":false,"required":["uid","created_at","producer","classification"],"properties":{"uid":{"type":"string","minLength":1,"maxLength":128},"created_at":{"type":"string","format":"date-time"},"producer":{"type":"string","minLength":1,"maxLength":128},"classification":{"enum":["PUBLIC","INTERNAL","RESTRICTED"]}}},"artifact_ref":{"type":"object","additionalProperties":false,"required":["uri","digest","media_type","schema_version"],"properties":{"uri":{"type":"string","pattern":"^artifacts/[A-Za-z0-9._~/-]+$"},"digest":{"$ref":"#/$defs/digest"},"media_type":{"type":"string","minLength":1,"maxLength":128},"schema_version":{"type":"string","minLength":1,"maxLength":128}}},"integrity":{"type":"object","additionalProperties":false,"required":["payload_digest"],"properties":{"payload_digest":{"$ref":"#/$defs/digest"},"evidence":{"type":"array","maxItems":32,"items":{"$ref":"#/$defs/artifact_ref"}}}}}}
