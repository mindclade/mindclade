load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "bindings",
    srcs = glob(["**/*.rs"]),
    crate_name = "mindclade_protocols",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "@crate_index//:prost",
        "@crate_index//:prost-types",
        "@crate_index//:tonic",
        "@crate_index//:tonic-prost",
    ],
)

filegroup(
    name = "generated_sources",
    srcs = glob(["**/*"]),
    visibility = ["//visibility:public"],
)
