load("@rules_python//python:defs.bzl", "py_test")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "wave1_contract_sources",
    srcs = [
        "BUILD.bazel",
        "README.md",
    ] + glob([
        "proto/**/*.proto",
        "events/**/*.proto",
        "events/**/*.yaml",
        "schemas/**/*.json",
        "openapi/**/*.yaml",
        "compatibility/baselines/*.json",
        "compatibility/tests/*.py",
    ]) + ["//protocols/generated:generated_sources"],
    visibility = ["//visibility:public"],
)

py_test(
    name = "protobuf_compatibility_test",
    srcs = ["compatibility/tests/test_protobuf_compatibility.py"],
    data = [
        ":wave1_contract_sources",
        "//tools:sdk_generator",
        "//tools:wave1_codegen_sources",
    ],
    imports = [".."],
    legacy_create_init = 0,
    main = "compatibility/tests/test_protobuf_compatibility.py",
    python_version = "PY3",
    visibility = ["//tests:__pkg__"],
    deps = ["@mindclade_pypi//protobuf"],
)

py_test(
    name = "schema_compatibility_test",
    srcs = ["compatibility/tests/test_schema_compatibility.py"],
    data = [
        ":wave1_contract_sources",
        "//tools:wave1_codegen_sources",
    ],
    imports = [".."],
    legacy_create_init = 0,
    main = "compatibility/tests/test_schema_compatibility.py",
    python_version = "PY3",
    visibility = ["//tests:__pkg__"],
    deps = ["@mindclade_pypi//jsonschema"],
)

py_test(
    name = "openapi_compatibility_test",
    srcs = ["compatibility/tests/test_openapi_compatibility.py"],
    data = [
        ":wave1_contract_sources",
        "//tools:wave1_codegen_sources",
    ],
    imports = [".."],
    legacy_create_init = 0,
    main = "compatibility/tests/test_openapi_compatibility.py",
    python_version = "PY3",
    visibility = ["//tests:__pkg__"],
    deps = [
        "@mindclade_pypi//protobuf",
        "@mindclade_pypi//pyyaml",
    ],
)
