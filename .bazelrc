import %workspace%/generated/bazelrc.common

common --repo_env=GOROOT
common --repo_env=MINDCLADE_NIX_BIN
common --repo_env=MINDCLADE_TOOLCHAIN_MANIFEST
common --repo_env=SDKROOT

build --action_env=SDKROOT
build --@rules_python//python/config_settings:python_version=3.12

# The Nix-provided Apple SDK exposes system headers through a module map that
# upstream Protobuf/Abseil exec tools do not declare.
build:macos --host_features=-layering_check

build:offline --remote_cache=
build:offline --remote_executor=
build:offline --disk_cache=
build:offline --noremote_accept_cached
build:offline --noremote_upload_local_results

build:cacheless --remote_cache=
build:cacheless --remote_executor=
build:cacheless --disk_cache=
build:cacheless --noremote_accept_cached
build:cacheless --noremote_upload_local_results

build:release --remote_cache=
build:release --remote_executor=
build:release --disk_cache=
build:release --noremote_accept_cached
build:release --noremote_upload_local_results

# RBE properties are source-qualified but deliberately disconnected. A future
# activation must populate endpoints through a separately reviewed config.
build:rbe-preparation --remote_cache=
build:rbe-preparation --remote_executor=
build:rbe-preparation --noremote_accept_cached
build:rbe-preparation --noremote_upload_local_results
