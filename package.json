{
  "name": "@mindclade/workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Private Mindclade monorepo workspace",
  "license": "LicenseRef-Mindclade-Proprietary",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=26.0.0 <27",
    "pnpm": ">=11.0.0 <12"
  },
  "scripts": {
    "check": "pnpm run check:manifest && biome check .",
    "check:manifest": "node -e \"JSON.parse(require('node:fs').readFileSync('package.json', 'utf8'))\"",
    "contracts:check": "python3.12 tools/codegen/verify_generated_drift.py --root .",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@bufbuild/protobuf": "2.11.0",
    "@bufbuild/protoc-gen-es": "2.11.0",
    "typescript": "5.9.3"
  }
}
