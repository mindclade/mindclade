load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "eventruntime",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    importpath = "github.com/mindclade/mindclade/libs/go/eventruntime",
    visibility = ["//visibility:public"],
    deps = [
        "//libs/go/persistence",
        "//libs/go/pubsubx",
        "//protocols/generated/go/admin/v1:bindings",
        "//protocols/generated/go/agent/v1:bindings",
        "//protocols/generated/go/artifact/v1:bindings",
        "//protocols/generated/go/audit/v1:bindings",
        "//protocols/generated/go/common/v1:bindings",
        "//protocols/generated/go/dataset/v1:bindings",
        "//protocols/generated/go/evaluation/v1:bindings",
        "//protocols/generated/go/experiment/v1:bindings",
        "//protocols/generated/go/feature/v1:bindings",
        "//protocols/generated/go/inference/v1:bindings",
        "//protocols/generated/go/job/v1:bindings",
        "//protocols/generated/go/model/v1:bindings",
        "//protocols/generated/go/policy/v1:bindings",
        "//protocols/generated/go/training/v1:bindings",
        "//protocols/generated/go/transform/v1:bindings",
        "//protocols/generated/go/workflow/v1:bindings",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//reflect/protoreflect",
    ],
)

go_test(
    name = "eventruntime_test",
    srcs = ["projection_test.go"],
    data = ["//services/control_plane:governed_inputs"],
    embed = [":eventruntime"],
    visibility = ["//tests:__pkg__"],
    deps = [
        "//libs/go/inbox",
        "//libs/go/numconv",
        "//libs/go/persistence",
        "//libs/go/pubsubx",
        "//protocols/generated/go/common/v1:bindings",
        "//protocols/generated/go/job/v1:bindings",
        "@com_github_jackc_pgx_v5//stdlib",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//reflect/protoregistry",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

filegroup(
    name = "governed_sources",
    srcs = ["BUILD.bazel"] + glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
