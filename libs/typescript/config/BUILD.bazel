load("@aspect_rules_js//js:defs.bzl", "js_library", "js_test")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")

ts_project(
    name = "config",
    srcs = glob(["src/*.ts"]),
    declaration = True,
    transpiler = "tsc",
    tsconfig = {
        "compilerOptions": {
            "declaration": True,
            "module": "ES2022",
            "moduleResolution": "Bundler",
            "strict": True,
            "target": "ES2022",
        },
    },
    visibility = ["//visibility:public"],
)

js_test(
    name = "resolution_test",
    entry_point = "tests/resolution.test.ts",
    data = [
        ":config",
        "package.json",
    ],
)

test_suite(
    name = "tests",
    tests = [
        ":config_typecheck_test",
        ":resolution_test",
    ],
)

filegroup(
    name = "governed_sources",
    srcs = ["BUILD.bazel", "package.json"] + glob(["src/*.ts", "tests/*.ts"]),
    visibility = ["//visibility:public"],
)
