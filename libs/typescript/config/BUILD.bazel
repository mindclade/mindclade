load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")

ts_project(
    name = "config",
    srcs = glob(["src/*.ts"]),
    declaration = True,
    transpiler = "tsc",
    tsconfig = {
        "compilerOptions": {
            "declaration": True,
            "module": "ES2022",
            "moduleResolution": "Bundler",
            "strict": True,
            "target": "ES2022",
        },
    },
    visibility = ["//visibility:public"],
    deps = ["//protocols/generated/typescript:bindings"],
)

js_test(
    name = "resolution_test",
    data = [
        "package.json",
        ":config",
    ],
    entry_point = "tests/resolution.test.ts",
)

test_suite(
    name = "tests",
    # resolution_test has :config in data, so analysis and execution both
    # require the strict TypeScript project to compile successfully.
    tests = [":resolution_test"],
)

filegroup(
    name = "governed_sources",
    srcs = [
        "BUILD.bazel",
        "package.json",
    ] + glob([
        "src/*.ts",
        "tests/*.ts",
    ]),
    visibility = ["//visibility:public"],
)
