load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")

ts_project(
    name = "observability",
    srcs = glob(["src/*.ts"]),
    declaration = True,
    transpiler = "tsc",
    tsconfig = {
        "compilerOptions": {
            "declaration": True,
            "module": "ES2022",
            "moduleResolution": "Bundler",
            "strict": True,
            "target": "ES2022",
        },
    },
    visibility = ["//visibility:public"],
)

js_test(
    name = "tracing_test",
    data = [
        "package.json",
        ":observability",
    ],
    entry_point = "tests/tracing.test.ts",
    visibility = ["//libs:__pkg__"],
)

test_suite(
    name = "tests",
    tests = [
        ":observability_typecheck_test",
        ":tracing_test",
    ],
)

filegroup(
    name = "governed_sources",
    srcs = [
        "BUILD.bazel",
        "package.json",
    ] + glob([
        "src/*.ts",
        "tests/*.ts",
    ]),
    visibility = ["//visibility:public"],
)
