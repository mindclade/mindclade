{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mindclade.dev/kernels/native-ops/v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "generator", "source_inventory_sha256", "namespace",
    "registration_mode", "optimized_math_authority", "runtime_discovery",
    "request_time_compilation", "operators", "semantic_digest", "manifest_digest"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "generator": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"const": "kernels.native.codegen.generate"},
        "version": {"const": 6}
      }
    },
    "source_inventory_sha256": {"$ref": "#/$defs/digest"},
    "namespace": {"const": "mindclade"},
    "registration_mode": {"const": "build_time_generated"},
    "optimized_math_authority": {"const": "tilelang"},
    "runtime_discovery": {"const": false},
    "request_time_compilation": {"const": false},
    "operators": {
      "type": "array", "maxItems": 4096, "uniqueItems": true,
      "items": {"$ref": "#/$defs/operator"}
    },
    "semantic_digest": {"$ref": "#/$defs/digest"},
    "manifest_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "value_name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"},
    "symbol": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 256},
    "schema": {"type": "string", "minLength": 1, "maxLength": 4096},
    "callable": {
      "type": "string", "maxLength": 512,
      "pattern": "^kernels\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.(?:reference|tilelang):[A-Za-z_][A-Za-z0-9_]*$"
    },
    "scalar": {"type": ["string", "integer", "number", "boolean"]},
    "expression": {
      "type": "object", "additionalProperties": false, "required": ["node"],
      "properties": {
        "node": {
          "enum": [
            "int_literal", "bool_literal", "float_literal", "string_literal",
            "dim_ref", "rank_ref", "scalar_ref", "dtype_ref", "device_ref",
            "same_as_input_dtype", "same_as_input_device", "constant_dtype",
            "constant_device", "add", "sub", "subtract", "mul", "multiply",
            "floor_div", "ceil_div", "mod", "modulo", "min", "minimum",
            "max", "maximum", "round_up", "eq", "not_equal", "less_than",
            "less_equal", "greater_than", "greater_equal", "and", "or", "not",
            "in_set", "select", "shape_of", "shape_prefix", "shape_tuple",
            "concat_shape", "broadcastable", "is_finite"
          ]
        },
        "argument": {"$ref": "#/$defs/value_name"},
        "axis": {"type": "integer"},
        "trailing_rank": {"type": "integer", "minimum": 0},
        "value_type": {"enum": ["bool", "int", "float", "string"]},
        "value": {
          "oneOf": [
            {"$ref": "#/$defs/scalar"},
            {"$ref": "#/$defs/expression"}
          ]
        },
        "lhs": {"$ref": "#/$defs/expression"},
        "rhs": {"$ref": "#/$defs/expression"},
        "operand": {"$ref": "#/$defs/expression"},
        "operands": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/expression"}},
        "members": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/scalar"}},
        "condition": {"$ref": "#/$defs/expression"},
        "when_true": {"$ref": "#/$defs/expression"},
        "when_false": {"$ref": "#/$defs/expression"},
        "multiple": {"$ref": "#/$defs/expression"},
        "dimensions": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/expression"}},
        "parts": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/expression"}}
      }
    },
    "initialization": {
      "type": ["object", "null"],
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "mode", "value", "version"],
          "properties": {
            "type": {"const": "InitializationSpec"},
            "mode": {"type": "string"},
            "value": {"type": ["integer", "number", "boolean", "null"]},
            "version": {"const": 1}
          }
        }
      ]
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": [
        "type", "name", "shape", "dtype", "device", "semantic_axes",
        "visible_in_facade", "saved_for_backward", "initialization", "version"
      ],
      "properties": {
        "type": {"const": "OutputSpec"},
        "name": {"$ref": "#/$defs/value_name"},
        "shape": {"$ref": "#/$defs/expression"},
        "dtype": {"$ref": "#/$defs/expression"},
        "device": {"$ref": "#/$defs/expression"},
        "semantic_axes": {"type": "array", "maxItems": 64, "items": {"type": "string"}, "uniqueItems": true},
        "visible_in_facade": {"type": "boolean"},
        "saved_for_backward": {"type": "boolean"},
        "initialization": {"$ref": "#/$defs/initialization"},
        "version": {"const": 1}
      }
    },
    "gradient": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "input_name", "output_name", "optional", "accumulation_dtype", "version"],
      "properties": {
        "type": {"const": "GradientSpec"},
        "input_name": {"$ref": "#/$defs/value_name"},
        "output_name": {"$ref": "#/$defs/value_name"},
        "optional": {"type": "boolean"},
        "accumulation_dtype": {"type": ["string", "null"]},
        "version": {"const": 1}
      }
    },
    "backward_argument_binding": {
      "type": "object", "additionalProperties": false,
      "required": [
        "type", "provider_argument", "source", "source_name", "missing", "version"
      ],
      "properties": {
        "type": {"const": "BackwardArgumentBinding"},
        "provider_argument": {"$ref": "#/$defs/value_name"},
        "source": {
          "enum": [
            "output_gradient", "operator_argument", "forward_output", "needs_input_grad"
          ]
        },
        "source_name": {"$ref": "#/$defs/value_name"},
        "missing": {"enum": ["error", "zero", "pass_none"]},
        "version": {"const": 1}
      }
    },
    "workspace": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "name", "shape", "dtype", "zero_initialize", "lifetime", "version"],
      "properties": {
        "type": {"const": "WorkspaceSpec"},
        "name": {"$ref": "#/$defs/value_name"},
        "shape": {"$ref": "#/$defs/shape_expression"},
        "dtype": {"$ref": "#/$defs/dtype_expression"},
        "zero_initialize": {"type": "boolean"},
        "lifetime": {"enum": ["node", "program_group"]},
        "version": {"const": 1}
      }
    },
    "shape_expression": {
      "allOf": [
        {"$ref": "#/$defs/expression"},
        {
          "properties": {
            "node": {"enum": ["shape_of", "shape_prefix", "shape_tuple", "concat_shape"]}
          }
        }
      ]
    },
    "dtype_expression": {
      "allOf": [
        {"$ref": "#/$defs/expression"},
        {
          "properties": {
            "node": {"enum": ["dtype_ref", "same_as_input_dtype", "constant_dtype", "select"]}
          }
        }
      ]
    },
    "workspace_use": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "workspace", "access", "version"],
      "properties": {
        "type": {"const": "WorkspaceUseSpec"},
        "workspace": {"$ref": "#/$defs/value_name"},
        "access": {"enum": ["read", "write", "read_write"]},
        "version": {"const": 1}
      }
    },
    "program_node": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "name", "builder", "symbol", "depends_on", "workspace_uses", "version"],
      "properties": {
        "type": {"const": "ProgramNodeSpec"},
        "name": {"$ref": "#/$defs/value_name"},
        "builder": {"$ref": "#/$defs/callable"},
        "symbol": {"$ref": "#/$defs/symbol"},
        "depends_on": {
          "type": "array", "maxItems": 64,
          "items": {"$ref": "#/$defs/value_name"}, "uniqueItems": true
        },
        "workspace_uses": {
          "type": "array", "maxItems": 64,
          "items": {"$ref": "#/$defs/workspace_use"}, "uniqueItems": true
        },
        "version": {"const": 1}
      }
    },
    "program_group": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "nodes", "workspaces", "version"],
          "properties": {
            "type": {"const": "ProgramGroupSpec"},
            "nodes": {
              "type": "array", "minItems": 1, "maxItems": 64,
              "items": {"$ref": "#/$defs/program_node"}, "uniqueItems": true
            },
            "workspaces": {
              "type": "array", "maxItems": 64,
              "items": {"$ref": "#/$defs/workspace"}, "uniqueItems": true
            },
            "version": {"const": 1}
          }
        }
      ]
    },
    "launcher_workspace_use": {
      "type": "object", "additionalProperties": false,
      "required": ["workspace", "access"],
      "properties": {
        "workspace": {"$ref": "#/$defs/value_name"},
        "access": {"enum": ["read", "write", "read_write"]}
      }
    },
    "launcher_node": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "symbol", "depends_on", "workspace_uses"],
      "properties": {
        "name": {"$ref": "#/$defs/value_name"},
        "symbol": {"$ref": "#/$defs/symbol"},
        "depends_on": {
          "type": "array", "maxItems": 64,
          "items": {"$ref": "#/$defs/value_name"}, "uniqueItems": true
        },
        "workspace_uses": {
          "type": "array", "maxItems": 64,
          "items": {"$ref": "#/$defs/launcher_workspace_use"}, "uniqueItems": true
        }
      }
    },
    "launcher_workspace": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "shape", "dtype", "zero_initialize", "lifetime"],
      "properties": {
        "name": {"$ref": "#/$defs/value_name"},
        "shape": {"$ref": "#/$defs/shape_expression"},
        "dtype": {"$ref": "#/$defs/dtype_expression"},
        "zero_initialize": {"type": "boolean"},
        "lifetime": {"enum": ["node", "program_group"]}
      }
    },
    "launcher_plan": {
      "type": "object", "additionalProperties": false,
      "required": [
        "phase", "logical_symbol", "bridge_requirement", "execution_order",
        "required_private_symbols", "nodes", "workspaces"
      ],
      "properties": {
        "phase": {"enum": ["forward", "backward"]},
        "logical_symbol": {"$ref": "#/$defs/symbol"},
        "bridge_requirement": {"const": "mindclade_program_group_bridge_v1"},
        "execution_order": {
          "type": "array", "minItems": 1, "maxItems": 64,
          "items": {"$ref": "#/$defs/value_name"}, "uniqueItems": true
        },
        "required_private_symbols": {
          "type": "array", "minItems": 1, "maxItems": 64,
          "items": {"$ref": "#/$defs/symbol"}, "uniqueItems": true
        },
        "nodes": {
          "type": "array", "minItems": 1, "maxItems": 64,
          "items": {"$ref": "#/$defs/launcher_node"}, "uniqueItems": true
        },
        "workspaces": {
          "type": "array", "maxItems": 64,
          "items": {"$ref": "#/$defs/launcher_workspace"}, "uniqueItems": true
        }
      }
    },
    "launcher_plans": {
      "type": "object", "additionalProperties": false,
      "required": ["forward", "backward"],
      "properties": {
        "forward": {
          "oneOf": [
            {"type": "null"},
            {
              "allOf": [
                {"$ref": "#/$defs/launcher_plan"},
                {"properties": {"phase": {"const": "forward"}}}
              ]
            }
          ]
        },
        "backward": {
          "oneOf": [
            {"type": "null"},
            {
              "allOf": [
                {"$ref": "#/$defs/launcher_plan"},
                {"properties": {"phase": {"const": "backward"}}}
              ]
            }
          ]
        }
      }
    },
    "forward": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "schema", "builder", "symbol", "outputs", "program_group", "version"],
      "properties": {
        "type": {"const": "ForwardSpec"},
        "schema": {"$ref": "#/$defs/schema"},
        "builder": {"$ref": "#/$defs/callable"},
        "symbol": {"$ref": "#/$defs/symbol"},
        "outputs": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/output"}, "uniqueItems": true},
        "program_group": {"$ref": "#/$defs/program_group"},
        "version": {"const": 1}
      }
    },
    "backward": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "schema", "builder", "symbol", "argument_bindings", "gradients", "supports_double_backward", "program_group", "version"],
          "properties": {
            "type": {"const": "BackwardSpec"},
            "schema": {"$ref": "#/$defs/schema"},
            "builder": {"$ref": "#/$defs/callable"},
            "symbol": {"$ref": "#/$defs/symbol"},
            "argument_bindings": {
              "type": "array", "minItems": 1, "maxItems": 64,
              "items": {"$ref": "#/$defs/backward_argument_binding"},
              "uniqueItems": true
            },
            "gradients": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gradient"}, "uniqueItems": true},
            "supports_double_backward": {"type": "boolean"},
            "program_group": {"$ref": "#/$defs/program_group"},
            "version": {"const": 1}
          }
        }
      ]
    },
    "composite": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": [
            "type", "decomposition", "source_digest", "runtime_envelope", "gradients",
            "supports_double_backward", "setup_context", "backward", "version"
          ],
          "properties": {
            "type": {"const": "CompositeAutogradSpec"},
            "decomposition": {"$ref": "#/$defs/callable"},
            "source_digest": {"$ref": "#/$defs/digest"},
            "runtime_envelope": {"type": "string", "minLength": 1, "maxLength": 512},
            "gradients": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gradient"}, "uniqueItems": true},
            "supports_double_backward": {"type": "boolean"},
            "setup_context": {"$ref": "#/$defs/callable"},
            "backward": {"$ref": "#/$defs/callable"},
            "version": {"const": 1}
          }
        }
      ]
    },
    "effects": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "mutates_inputs", "aliases_outputs", "uses_rng", "uses_atomics", "version"],
      "properties": {
        "type": {"const": "EffectSpec"},
        "mutates_inputs": {"type": "array", "items": {"$ref": "#/$defs/value_name"}, "uniqueItems": true},
        "aliases_outputs": {
          "type": "array", "uniqueItems": true,
          "items": {
            "type": "array", "prefixItems": [{"$ref": "#/$defs/value_name"}, {"$ref": "#/$defs/value_name"}],
            "minItems": 2, "maxItems": 2
          }
        },
        "uses_rng": {"type": "boolean"},
        "uses_atomics": {"type": "boolean"},
        "version": {"const": 1}
      }
    },
    "launch": {
      "type": "object", "additionalProperties": false,
      "required": [
        "type", "current_stream_only", "global_synchronization", "hidden_device_allocation",
        "graph_capture_safe", "determinism", "version"
      ],
      "properties": {
        "type": {"const": "LaunchContract"},
        "current_stream_only": {"type": "boolean"},
        "global_synchronization": {"type": "boolean"},
        "hidden_device_allocation": {"type": "boolean"},
        "graph_capture_safe": {"type": "boolean"},
        "determinism": {"enum": ["deterministic", "conditionally_deterministic", "nondeterministic"]},
        "version": {"const": 1}
      }
    },
    "registration": {
      "type": "object", "additionalProperties": false,
      "required": ["qualified_name", "schema", "kind", "implementation_symbol"],
      "properties": {
        "qualified_name": {"type": "string", "pattern": "^mindclade::_?[a-z][a-z0-9_]{0,63}$"},
        "schema": {"$ref": "#/$defs/schema"},
        "kind": {"enum": ["semantic", "forward", "backward"]},
        "implementation_symbol": {"$ref": "#/$defs/symbol"}
      }
    },
    "dimension_constraint": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "predicate", "code", "message", "version"],
      "properties": {
        "type": {"const": "DimensionConstraint"},
        "predicate": {"$ref": "#/$defs/expression"},
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
        "message": {"type": "string", "minLength": 1, "maxLength": 512},
        "version": {"const": 1}
      }
    },
    "tensor_capability_constraint": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "argument", "dtypes", "layouts", "devices", "ranks", "version"],
      "properties": {
        "type": {"const": "TensorCapabilityConstraint"},
        "argument": {"$ref": "#/$defs/value_name"},
        "dtypes": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 64}, "uniqueItems": true},
        "layouts": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 64}, "uniqueItems": true},
        "devices": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 64}, "uniqueItems": true},
        "ranks": {"type": "array", "maxItems": 64, "items": {"type": "integer", "minimum": 0}, "uniqueItems": true},
        "version": {"const": 1}
      }
    },
    "capability_envelope": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "architectures", "dtypes", "layouts", "modes", "constraints", "graph_capture_safe", "training_capable", "tensor_constraints", "version"],
      "properties": {
        "type": {"const": "CapabilityEnvelope"},
        "architectures": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 64}, "uniqueItems": true},
        "dtypes": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 64}, "uniqueItems": true},
        "layouts": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 64}, "uniqueItems": true},
        "modes": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 64}, "uniqueItems": true},
        "constraints": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/dimension_constraint"}, "uniqueItems": true},
        "graph_capture_safe": {"type": "boolean"},
        "training_capable": {"type": "boolean"},
        "tensor_constraints": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/tensor_capability_constraint"}, "uniqueItems": true},
        "version": {"const": 1}
      }
    },
    "implementation_candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "tier", "priority", "requires", "envelope", "envelope_digest", "promoted", "selectable"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "version": {"type": "integer", "minimum": 1},
        "tier": {"enum": ["portable", "optimized", "specialized", "hand_specialized"]},
        "priority": {"type": "integer"},
        "requires": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 128}, "uniqueItems": true},
        "envelope": {"$ref": "#/$defs/capability_envelope"},
        "envelope_digest": {"$ref": "#/$defs/digest"},
        "promoted": {"const": false},
        "selectable": {"const": false}
      }
    },
    "registrations": {
      "type": "array", "minItems": 2, "maxItems": 3,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/registration"}, {"properties": {"kind": {"const": "semantic"}}}]},
        {"allOf": [{"$ref": "#/$defs/registration"}, {"properties": {"kind": {"const": "forward"}}}]},
        {"allOf": [{"$ref": "#/$defs/registration"}, {"properties": {"kind": {"const": "backward"}}}]}
      ],
      "items": false
    },
    "operator": {
      "type": "object", "additionalProperties": false,
      "required": [
        "name", "qualified_name", "namespace", "family", "source", "spec_sha256",
        "kernel_spec_digest", "implementation_digest", "implementation_candidates", "operator_schema", "facade_outputs", "fake", "forward",
        "backward", "autograd_policy", "composite", "effects", "launch", "backend",
        "version", "devices", "registrations", "launcher_plans"
      ],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "qualified_name": {"type": "string", "pattern": "^mindclade::[a-z][a-z0-9_]{0,63}$"},
        "namespace": {"const": "mindclade"},
        "family": {"$ref": "#/$defs/name"},
        "source": {"type": "string", "pattern": "^[a-z][a-z0-9_]*/[a-z][a-z0-9_]*/spec\\.py$", "maxLength": 160},
        "spec_sha256": {"$ref": "#/$defs/digest"},
        "kernel_spec_digest": {"$ref": "#/$defs/digest"},
        "implementation_digest": {"$ref": "#/$defs/digest"},
        "implementation_candidates": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/implementation_candidate"}, "uniqueItems": true},
        "operator_schema": {"$ref": "#/$defs/schema"},
        "facade_outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/value_name"}, "uniqueItems": true},
        "fake": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/callable"}]},
        "forward": {"$ref": "#/$defs/forward"},
        "backward": {"$ref": "#/$defs/backward"},
        "autograd_policy": {"enum": ["required", "none", "composite"]},
        "composite": {"$ref": "#/$defs/composite"},
        "effects": {"$ref": "#/$defs/effects"},
        "launch": {"$ref": "#/$defs/launch"},
        "backend": {"const": "tilelang"},
        "version": {"type": "integer", "minimum": 1},
        "devices": {"const": ["cuda"]},
        "registrations": {"$ref": "#/$defs/registrations"},
        "launcher_plans": {"$ref": "#/$defs/launcher_plans"}
      }
    }
  }
}
