load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:private"])

cc_library(
    name = "native_schema",
    srcs = [
        "generated/registration.generated.cpp",
        "stable_abi/registration.cpp",
        "stable_abi/tensor_bridge.cpp",
    ],
    defines = [
        "MINDCLADE_NATIVE_SCHEMA_ONLY=1",
        "MINDCLADE_TORCH_STABLE_ABI_MAJOR=2",
        "MINDCLADE_TORCH_STABLE_ABI_MINOR=10",
    ],
    linkstatic = False,
)

# The qualified GPU artifact must export every generated C-linkage launch
# symbol. Keeping this registry separate prevents schema-only builds from
# acquiring unresolved GPU launch dependencies.
cc_library(
    name = "native_cuda_registry",
    srcs = ["generated/operation_registry.generated.cpp"],
    alwayslink = True,
    defines = [
        "MINDCLADE_TORCH_STABLE_ABI_MAJOR=2",
        "MINDCLADE_TORCH_STABLE_ABI_MINOR=10",
    ],
)

# Operation declarations are explicit build inputs owned by operation-local
# packages. Codegen receives no implicit repository discovery inputs.
filegroup(
    name = "native_operator_spec_sources",
    srcs = [
        "//kernels/pairformer/outer_product_mean:spec.py",
        "//kernels/pairformer/pair_weighted_average:spec.py",
        "//kernels/pairformer/triangle_attention:spec.py",
        "//kernels/pairformer/triangle_multiplication:spec.py",
        "//kernels/pairformer/transition:spec.py",
    ],
)

filegroup(
    name = "native_tilelang_builder_sources",
    srcs = [
        "//kernels/pairformer/outer_product_mean:tilelang.py",
        "//kernels/pairformer/pair_weighted_average:tilelang.py",
        "//kernels/pairformer/triangle_attention:tilelang.py",
        "//kernels/pairformer/triangle_multiplication:tilelang.py",
        "//kernels/pairformer/transition:tilelang.py",
    ],
)

py_library(
    name = "tilelang_codegen_lib",
    srcs = [
        "tilelang/__init__.py",
        "tilelang/build.py",
        "tilelang/decorator.py",
        "tilelang/manifest.py",
        "tilelang/model.py",
        "tilelang/registry.py",
        "tilelang/tma.py",
        "tilelang/targets.py",
        "tilelang/swizzle.py",
    ],
    deps = [
        ":native_codegen_lib",
        "//kernels/api:api",
    ],
    visibility = ["//kernels/pairformer/transition:__pkg__"],
)

py_library(
    name = "native_codegen_lib",
    srcs = [
        "codegen/__init__.py",
        "codegen/discover.py",
        "codegen/generate.py",
        "codegen/parse_literal_ast.py",
        "codegen/schema.py",
    ],
    data = [
        ":native_operator_spec_sources",
        ":native_tilelang_builder_sources",
        "manifests/native_ops.schema.json",
    ],
    deps = ["//kernels/api:api"],
)

# This is the sole generated-output owner. It runs only as an explicit Bazel
# build/codegen action and receives no implicit discovery or network inputs.
py_binary(
    name = "generate_native_ops",
    srcs = ["codegen/generate.py"],
    data = [
        ":native_operator_spec_sources",
        ":native_tilelang_builder_sources",
        "generated/native_ops.generated.bzl",
        "generated/native_ops.generated.cmake",
        "generated/native_ops.json",
        "generated/operation_registry.generated.cpp",
        "generated/python_registration_generated.py",
        "generated/registration.generated.cpp",
    ],
    main = "codegen/generate.py",
    deps = [":native_codegen_lib"],
)

py_library(
    name = "native_manifest",
    srcs = [
        "tilelang/__init__.py",
        "tilelang/manifest.py",
    ],
    data = ["generated/native_ops.json"],
)

py_library(
    name = "native_python",
    srcs = [
        "python/__init__.py",
        "python/loader.py",
        "python/qualification.py",
        "python/reference_runtime.py",
        "python/registration.py",
    ],
    data = ["generated/python_registration_generated.py"],
    deps = [":native_manifest"],
)

filegroup(
    name = "native_policy_inputs",
    srcs = [
        "BUILD.bazel",
        "CMakeLists.txt",
        "IMPLEMENTATION_STATUS.md",
        "MIGRATION.md",
        "README.md",
        "cmake/MindcladeTorchStable.cmake",
