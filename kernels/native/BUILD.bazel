    name = "torch_runtime_tests",
    tests = [
        ":test_autograd",
        ":test_export",
        ":test_fake_tensor",
        ":test_loader_policy",
        ":test_namespace",
        ":test_opcheck",
    ],
    tags = [
        "manual",
        "requires-hermetic-torch-2.10",
    ],
)

