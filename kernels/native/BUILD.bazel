package(default_visibility = ["//visibility:private"])

cc_library(
    name = "native_schema",
    srcs = [
        "stable_abi/registration.cpp",
        "stable_abi/tensor_bridge.cpp",
    ],
    defines = [
        "MINDCLADE_NATIVE_SCHEMA_ONLY=1",
        "MINDCLADE_TORCH_STABLE_ABI_MAJOR=2",
        "MINDCLADE_TORCH_STABLE_ABI_MINOR=10",
    ],
    linkstatic = False,
)

# Operation declarations are explicit build inputs. The Wave 6 TARGET has no
# authoring sources until a JIT-06-qualified operation is activated.
filegroup(
    name = "native_operator_authoring_sources",
    srcs = [],
)

py_library(
    name = "tilelang_codegen_lib",
    srcs = [
        "tilelang/__init__.py",
        "tilelang/decorator.py",
        "tilelang/manifest.py",
        "tilelang/model.py",
        "tilelang/registry.py",
    ],
)

py_library(
    name = "native_codegen_lib",
    srcs = [
        "codegen/__init__.py",
        "codegen/discover.py",
        "codegen/schema.py",
    ],
    data = [":native_operator_authoring_sources"],
    deps = [":tilelang_codegen_lib"],
)

# This is the sole generated-output owner. It runs only as an explicit Bazel
# build/codegen action and receives no implicit discovery or network inputs.
py_binary(
    name = "generate_native_ops",
    srcs = ["codegen/generate.py"],
    data = [":native_operator_authoring_sources"],
    deps = [":native_codegen_lib"],
)

py_library(
    name = "native_python",
    srcs = [
        "python/__init__.py",
        "python/loader.py",
        "python/registration.py",
    ],
)

filegroup(
    name = "native_policy_inputs",
    srcs = [
        "BUILD.bazel",
        "CMakeLists.txt",
        "IMPLEMENTATION_STATUS.md",
        "MIGRATION.md",
        "README.md",
        "cmake/MindcladeTorchStable.cmake",
        "codegen/__init__.py",
        "codegen/discover.py",
        "codegen/generate.py",
        "codegen/schema.py",
        "component.yaml",
        "cuda/CMakeLists.txt",
        "cuda/README.md",
        "cuda/operation_registry.cpp",
        "stable_abi/CMakeLists.txt",
        "stable_abi/abi_manifest.json",
        "stable_abi/registration.cpp",
        "stable_abi/tensor_bridge.cpp",
        "tilelang/README.md",
        "tilelang/__init__.py",
        "tilelang/decorator.py",
        "tilelang/manifest.py",
        "tilelang/model.py",
        "tilelang/registry.py",
        "generated/native_ops.json",
    ],
)

