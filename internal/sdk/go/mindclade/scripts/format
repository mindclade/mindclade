#!/usr/bin/env bash
# Apply this package's owning formatter.
#
# Mirrors the Go half of `just format`, narrowed to the SDK. golangci-lint owns
# Go formatting in this repository, so this script must not substitute a bare
# gofmt: the two disagree about import grouping and the repository-wide
# `just format-check` gate is the golangci-lint one.

set -euo pipefail

# shellcheck source=internal/sdk/go/mindclade/scripts/common.sh
source "$(dirname -- "${BASH_SOURCE[0]}")/common.sh"
cd -- "$(repository_root)"

require_tool golangci-lint \
  "install golangci-lint built against this module's Go version; see docs/development."

announce "golangci-lint fmt ${SDK_GO_PATTERN}"
golangci-lint fmt "${SDK_GO_PATTERN}"
