#!/usr/bin/env bash
# Run static analysis for this package.
#
# Mirrors the Go half of `just lint` and `just format-check`, narrowed to the
# SDK. Formatting is checked as a diff rather than rewritten, so lint never
# mutates the working tree; run `scripts/format` to apply the change.

set -euo pipefail

# shellcheck source=internal/sdk/go/mindclade/scripts/common.sh
source "$(dirname -- "${BASH_SOURCE[0]}")/common.sh"
cd -- "$(repository_root)"

require_tool golangci-lint \
  "install golangci-lint built against this module's Go version; see docs/development."

announce "golangci-lint fmt --diff ${SDK_GO_PATTERN}"
golangci-lint fmt --diff "${SDK_GO_PATTERN}"

announce "golangci-lint run ${SDK_GO_PATTERN}"
golangci-lint run "${SDK_GO_PATTERN}"
