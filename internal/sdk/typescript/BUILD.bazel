load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")

npm_link_all_packages(name = "node_modules")

# NodeNext classifies source files using the nearest package.json. Make that
# package boundary an explicit compiler input so sandboxed Bazel builds emit
# the same ESM as pnpm/tsc.
ts_config(
    name = "sdk_tsconfig",
    src = "tsconfig.json",
    deps = [
        "package.json",
        "//protocols/generated/typescript:bindings",
    ],
)

ts_project(
    name = "mindclade_internal_sdk",
    srcs = glob(["src/*.ts"]),
    declaration = True,
    transpiler = "tsc",
    tsconfig = ":sdk_tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        ":node_modules/@bufbuild/protobuf",
        ":node_modules/@connectrpc/connect",
        ":node_modules/@connectrpc/connect-node",
        ":node_modules/@types/node",
        "//protocols/generated/typescript:bindings",
    ],
)

# Local-only package tree consumed by pnpm workspace links in internal apps.
# Publishing and packing remain disabled; service-to-service transport authority
# stays with the generated Connect/gRPC bindings beneath this facade.
npm_package(
    name = "pkg",
    srcs = [
        "bazel/package.json",
        ":mindclade_internal_sdk",
        "//protocols/generated/typescript:bindings",
    ],
    include_srcs_packages = [
        "internal/sdk/typescript",
        "protocols/generated/typescript",
    ],
    package = "@mindclade/internal-sdk",
    replace_prefixes = {"internal/sdk/typescript/bazel": ""},
    root_paths = ["__preserve_workspace_paths__"],
    visibility = ["//visibility:public"],
)

js_test(
    name = "sdk_test",
    data = [
        "package.json",
        ":governed_sources",
        ":mindclade_internal_sdk",
