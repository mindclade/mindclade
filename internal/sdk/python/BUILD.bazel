    name = "mindclade_internal_sdk",
    srcs = glob(["mindclade_internal_sdk/*.py"]),
    imports = ["."],
    deps = [
        "//protocols/generated/python:bindings",
        "@mindclade_pypi//google_auth",
        "@mindclade_pypi//grpcio",
        "@mindclade_pypi//protobuf",
        "@mindclade_pypi//requests",
    ],
)

