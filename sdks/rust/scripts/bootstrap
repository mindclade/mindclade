#!/bin/sh
# Prepare a working tree for internal Rust SDK development.
#
# Two things have to be true before this crate can be worked on, and they fail
# for different reasons, so they are run and reported separately:
#
#   1. the crate's dependency graph resolves against the committed lockfile;
#   2. the repository's pinned toolchain is present at its exact versions,
#      which `just bootstrap` (tools/dev/bootstrap.py) is the authority on.
#
# The lockfile is authoritative: a resolution that is not already recorded is a
# governance change, not a developer convenience, so `--locked` is not optional.
#
# Arguments are forwarded to the toolchain audit.

set -eu

. "$(dirname -- "$0")/common.sh"

require_tool "${CARGO}" \
  "install the pinned Rust toolchain; see docs/development or run 'nix develop'."

announce "${CARGO} metadata --locked --no-deps (${SDK_CARGO_PACKAGE})"
"${CARGO}" metadata --locked --no-deps --format-version=1 >/dev/null

if bazel_requested; then
  require_tool bazel "install Bazelisk, or unset MINDCLADE_BAZEL to use the native toolchain."
  announce "bazel fetch ${SDK_BAZEL_LIBRARY}"
  bazel fetch "${SDK_BAZEL_LIBRARY}"
fi

if command -v just >/dev/null 2>&1; then
  audit_command="just bootstrap"
else
  require_tool python3 "install Python 3.12; see docs/development or run 'nix develop'."
  audit_command="python3 tools/dev/bootstrap.py --root ."
fi

announce "${audit_command} $*"
# shellcheck disable=SC2086
if ! ${audit_command} "$@"; then
  printf '\n' >&2
  printf 'bootstrap: %s resolves against the committed lockfile, but the\n' \
    "${SDK_PACKAGE_DIR}" >&2
  printf '           repository toolchain audit above reported a gap. Install or\n' >&2
  printf '           re-pin the tools it named before running scripts/lint,\n' >&2
  printf '           scripts/format, or the repository gates.\n' >&2
  exit 1
fi

printf 'bootstrap: ready for %s\n' "${SDK_PACKAGE_DIR}" >&2
