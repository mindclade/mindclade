load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

SDK_DEPS = [
    "//protocols/generated/rust:bindings",
    "@crate_index//:prost",
    "@crate_index//:prost-types",
    "@crate_index//:serde_json",
    "@crate_index//:sha2",
    "@crate_index//:tokio",
    "@crate_index//:tonic",
]

rust_library(
    name = "mindclade_internal_sdk",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "mindclade_internal_sdk",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = SDK_DEPS,
)

rust_test(
    name = "mindclade_internal_sdk_test",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["Cargo.toml"],
    crate_root = "src/lib.rs",
    data = [":governed_sources"],
    edition = "2024",
    visibility = ["//tests:__pkg__"],
    deps = SDK_DEPS,
)

filegroup(
    name = "governed_sources",
    srcs = ["BUILD.bazel"] + glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
