#!/usr/bin/env bash
# Static analysis for this package only.
#
# Biome carries the repository style and correctness rules; tsc carries the type
# contract. Both run because a lint pass that cannot see types would accept a
# surface the package does not actually export.
set -euo pipefail

cd "$(dirname "$0")/../../.."

"${PNPM:-pnpm}" --filter ./sdks/typescript run lint
"${PNPM:-pnpm}" --filter ./sdks/typescript run typecheck
