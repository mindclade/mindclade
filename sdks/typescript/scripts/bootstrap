#!/usr/bin/env bash
# Install the pinned workspace dependencies this package builds and tests against.
#
# The lockfile is authoritative: a resolution that is not already recorded is a
# governance change, not a developer convenience, so the install refuses to
# rewrite it.
set -euo pipefail

cd "$(dirname "$0")/../../.."

"${PNPM:-pnpm}" install --frozen-lockfile
