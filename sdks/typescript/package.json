{
	"name": "@mindclade/internal-sdk",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./dist/native/sdks/typescript/src/index.js"
		}
	},
	"scripts": {
		"build": "rm -rf dist/native && tsc -p tsconfig.json --noEmit false --rootDir ../.. --outDir dist/native",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "pnpm run build && node --test dist/native/sdks/typescript/tests/*.test.js",
		"lint": "cd ../.. && biome check --config-path sdks/typescript/biome.json sdks/typescript"
	},
	"dependencies": {
		"@bufbuild/protobuf": "2.11.0",
		"@connectrpc/connect": "catalog:",
		"@connectrpc/connect-node": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"typescript": "catalog:"
	}
}
