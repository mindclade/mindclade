#!/usr/bin/env bash
# Run static analysis for this package.
#
# Mirrors the Python half of `just lint` and `just format-check`, narrowed to
# the SDK. Three checks run because they catch different classes of defect and
# none subsumes another:
#
#   * ruff format --check reports style drift as a diff rather than rewriting
#     the tree, so lint never mutates a working copy; run scripts/format to
#     apply it.
#   * ruff check carries the repository's correctness and import rules.
#   * pyright carries the type contract in strict mode, which is what stops an
#     exported surface from drifting from the one the package documents.

set -euo pipefail

# shellcheck source=sdks/python/scripts/common.sh
source "$(dirname -- "${BASH_SOURCE[0]}")/common.sh"
cd -- "$(repository_root)"

require_tool ruff "install the pinned ruff; see docs/development or run 'nix develop'."

announce "ruff format --check ${SDK_PACKAGE_DIR}"
ruff format --check "${SDK_PACKAGE_DIR}"

announce "ruff check ${SDK_PACKAGE_DIR}"
ruff check "${SDK_PACKAGE_DIR}"

uv_run pyright --project "${SDK_PYRIGHT_PROJECT}"
