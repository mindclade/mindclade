{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mindclade.dev/architecture/blueprint-manifest.v1.schema.json",
  "title": "Mindclade architecture blueprint source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "document",
    "sources",
    "heading_anchor_expectations",
    "repository_path_manifest",
    "generated_output",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "mindclade.dev/architecture-blueprint-manifest/v1"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "version",
        "status",
        "scope",
        "audience",
        "effective_date",
        "supersedes",
        "review_cadence",
        "repository_evidence_reviewed",
        "authority_note"
      ],
      "properties": {
        "id": {"const": "MC-ARCH-001"},
        "title": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "status": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "minLength": 1},
        "effective_date": {"type": "string", "format": "date"},
        "supersedes": {"type": "string", "minLength": 1},
        "review_cadence": {"type": "string", "minLength": 1},
        "repository_evidence_reviewed": {"type": "string", "minLength": 1},
        "authority_note": {"type": "string", "minLength": 1}
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sections", "appendices"],
      "properties": {
        "sections": {
          "type": "array",
          "minItems": 18,
          "maxItems": 18,
          "items": {"$ref": "#/$defs/source"}
        },
        "appendices": {
          "type": "array",
          "minItems": 40,
          "maxItems": 40,
          "items": {"$ref": "#/$defs/source"}
        }
      }
    },
    "heading_anchor_expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_heading_level",
        "section_heading_template",
        "appendix_heading_template",
        "anchor_algorithm",
        "reject_duplicate_anchors"
      ],
      "properties": {
        "source_heading_level": {"const": 2},
        "section_heading_template": {"const": "## {number}. {title}"},
        "appendix_heading_template": {"const": "## Appendix A{number} — {title}"},
        "anchor_algorithm": {"const": "gfm"},
        "reject_duplicate_anchors": {"const": true}
      }
    },
    "repository_path_manifest": {
      "const": "../repository-path-manifest.yaml"
    },
    "generated_output": {
      "const": "generated/MINDCLADE_MONOREPO_BLUEPRINT_FULL.md"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blueprint_v3_4_0", "repository_tree"],
      "properties": {
        "blueprint_v3_4_0": {"$ref": "#/$defs/provenance"},
        "repository_tree": {"$ref": "#/$defs/provenance"}
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "title", "path"],
      "properties": {
        "number": {"type": "integer", "minimum": 1, "maximum": 40},
        "title": {"type": "string", "minLength": 1},
        "path": {
          "type": "string",
          "pattern": "^(sections|appendices)/[A-Za-z0-9][A-Za-z0-9._-]*\\.md$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^provenance/[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
