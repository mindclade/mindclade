{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mindclade.dev/repository/activation-bundles.v1.schema.json",
  "title": "Mindclade repository activation bundles v1",
  "type": "object",
  "required": ["$schema", "schema_version", "authority", "bundles"],
  "properties": {
    "$schema": {"const": "./activation-bundles.schema.json"},
    "schema_version": {"const": "mindclade.activation-bundles/v1"},
    "authority": {"$ref": "#/$defs/path"},
    "bundles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/bundle"}
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\*{}<>…])(?!.*//)(?!.*\\/$).+$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "constant": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "bundle": {
      "type": "object",
      "required": [
        "id",
        "constant",
        "authority",
        "owner",
        "activation_wave",
        "status",
        "reason",
        "paths"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "constant": {"$ref": "#/$defs/constant"},
        "authority": {"$ref": "#/$defs/path"},
        "owner": {"$ref": "#/$defs/identifier"},
        "activation_wave": {
          "type": "string",
          "pattern": "^(?:[0-9]+|[0-9]+[PS])$"
        },
        "status": {
          "enum": ["candidate", "active", "generated", "deferred", "retired"]
        },
        "reason": {"type": "string", "minLength": 1},
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/path"}
        },
        "predeclared_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/path"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
