load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//tools:bazel/rules/component_rule.bzl", "component_metadata")
load("//tools:bazel/toolchain_probe.bzl", "configured_toolchain_probe")

package(default_visibility = ["//visibility:private"])

_IGNORED_SOURCE_PATTERNS = [
    "**/__pycache__/**",
    "**/*.pyc",
    "**/*.pyo",
    "**/.DS_Store",
]

component_metadata(
    name = "root_component_metadata",
    component_name = "mindclade",
    metadata = "//:component.yaml",
    owner = "product-engineering",
)

configured_toolchain_probe(
    name = "configured_toolchain_probe",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "repository_governance",
    srcs = glob(
        ["**"],
        exclude = _IGNORED_SOURCE_PATTERNS,
    ),
    visibility = ["//visibility:public"],
)

py_test(
    name = "required_check_contract_test",
    srcs = [
        "ci/affected_targets.py",
        "ci/evidence_bundle.py",
        "ci/pipeline_plan.py",
        "ci/required_check.py",
    ],
    args = ["--self-test"],
    data = [
        "repo/repository_drift.v1.schema.json",
        "repo/tests/golden/repository_drift.v1.json",
    ],
    imports = ["ci"],
    legacy_create_init = 0,
    main = "ci/required_check.py",
    python_version = "PY3",
    deps = [
        "@mindclade_pypi//cryptography",
        "@mindclade_pypi//jsonschema",
    ],
)

