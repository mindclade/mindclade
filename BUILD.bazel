load("@npm//:defs.bzl", "npm_link_all_packages")
load("@rules_python//python:defs.bzl", "py_test")

package(default_visibility = ["//visibility:private"])

npm_link_all_packages(name = "node_modules")

exports_files([
    "ARCHITECTURE.md",
    "flake.lock",
    "flake.nix",
    "LICENSE",
    "NOTICE",
    "README.md",
    "component.yaml",
    "pyproject.toml",
    "uv.lock",
])

filegroup(
    name = "generated_policy_bundle",
    srcs = glob(["generated/**"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "wave0_governance_sources",
    srcs = [
        ".bazelignore",
        ".bazelrc",
        ".bazelversion",
        ".editorconfig",
        ".gitattributes",
        ".gitignore",
        ".golangci.yml",
        ".markdownlint-cli2.yaml",
        ".pre-commit-config.yaml",
        ".python-version",
        ".yamllint.yaml",
        "AGENTS.md",
        "ARCHITECTURE.md",
        "BUILD.bazel",
        "CODE_OF_CONDUCT.md",
        "CONTRIBUTING.md",
        "Cargo.lock",
        "Cargo.toml",
        "LICENSE",
        "MODULE.bazel",
        "MODULE.bazel.lock",
        "NOTICE",
        "README.md",
        "SECURITY.md",
        "biome.json",
        "buf.gen.yaml",
        "buf.lock",
        "buf.yaml",
        "component.yaml",
        "flake.lock",
        "flake.nix",
        "go.mod",
        "go.sum",
        "justfile",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "pyproject.toml",
        "rust-toolchain.toml",
        "uv.lock",
        ":generated_policy_bundle",
        "//docs:documentation",
        "//tools:repository_governance",
    ] + glob(
        [
            ".buildkite/**",
            ".devcontainer/**",
            ".github/**",
            ".vscode/**",
        ],
        exclude = [
            "**/__pycache__/**",
            "**/*.pyc",
            "**/*.pyo",
            "**/.DS_Store",
        ],
    ),
    visibility = ["//visibility:public"],
)

py_test(
    name = "buildkite_pipeline_model_test",
    srcs = [".buildkite/pipeline.py"] + glob([
        ".buildkite/lib/*.py",
        ".buildkite/steps/*.py",
    ]),
    args = ["--check"],
    imports = [
        ".buildkite/lib",
        ".buildkite/steps",
    ],
    legacy_create_init = 0,
    main = ".buildkite/pipeline.py",
    python_version = "PY3",
)

test_suite(
    name = "wave0_tests",
    tests = [
        ":buildkite_pipeline_model_test",
        "//tools:repository_governance_tests",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "wave1_contract_sources",
    srcs = [
        "//protocols:wave1_contract_sources",
        "//tests:wave1_contract_sources",
        "//third_party:wave1_third_party_sources",
        "//tools:wave1_tooling_sources",
    ],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "wave1_contract_tests",
    tests = ["//tests:wave1_contract_tests"],
    visibility = ["//visibility:public"],
)

# ADR-0015 activates the complete v1 contract catalog without changing the
# existing Wave 1 compatibility aliases. The protocol package glob is the
# source inventory; the conformance suite validates generated projections and
# compatibility for that inventory.
filegroup(
    name = "internal_sdk_root_sources",
    srcs = [
        "internal/sdk/README.md",
        "internal/sdk/rpc-coverage.generated.json",
        "internal/sdk/rpc-coverage.yaml",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "all_contract_sources",
    srcs = [
        ":internal_sdk_root_sources",
        ":wave1_contract_sources",
        "//examples:governed_sources",
        "//internal/sdk/go/mindclade:governed_sources",
        "//internal/sdk/python:governed_sources",
        "//internal/sdk/rust:governed_sources",
        "//internal/sdk/typescript:governed_sources",
        "//services/control_plane:control_plane_sources",
        "//tests:all_contract_sources",
    ],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "all_contract_tests",
    tests = ["//tests:all_contract_tests"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "wave1_sources",
    srcs = [
        ":wave1_contract_sources",
        "//deploy:local_profile",
        "//libs:foundation_sources",
        "//services/control_plane:control_plane_sources",
        "//tests:wave1_contract_sources",
        "//third_party:wave1_third_party_sources",
        "//tools:wave1_tooling_sources",
    ],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "wave1_tests",
    tests = [
        ":wave1_contract_tests",
        "//libs:foundation_tests",
        "//services/control_plane:tests",
        "//tests:artifact_commit_integration_test",
        "//tests:configuration_resolution_test",
        "//tests:control_worker_integration_test",
        "//tests:local_stack_integration_test",
        "//tests:release_signing_test",
        "//tools:repository_policies_test",
    ],
    visibility = ["//visibility:public"],
)

# Wave 2S currently exposes only the source-qualified native kernel policy
# closure. The suite intentionally makes no GPU or production qualification
# claim; it includes deterministic generator drift through policy_tests.
test_suite(
    name = "wave2s_tests",
    tests = ["//kernels/native:policy_tests"],
    visibility = ["//visibility:public"],
)

# Wave 2P protocol and facade changes retain the complete contract baseline as
# their minimum source-level regression closure until runtime targets activate.
test_suite(
    name = "wave2p_tests",
    tests = [":all_contract_tests"],
    visibility = ["//visibility:public"],
)
