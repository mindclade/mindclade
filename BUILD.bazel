load("@npm//:defs.bzl", "npm_link_all_packages")
load("@rules_python//python:defs.bzl", "py_test")

package(default_visibility = ["//visibility:private"])

npm_link_all_packages(name = "node_modules")

exports_files([
    "ARCHITECTURE.md",
    "flake.lock",
    "flake.nix",
    "LICENSE",
    "NOTICE",
    "README.md",
    "component.yaml",
    "pyproject.toml",
    "uv.lock",
])

filegroup(
    name = "wave0_governance_sources",
    srcs = [
        ".bazelrc",
        ".bazelversion",
        ".editorconfig",
        ".gitattributes",
        ".gitignore",
        ".markdownlint-cli2.yaml",
        ".pre-commit-config.yaml",
        ".python-version",
        ".yamllint.yaml",
        "AGENTS.md",
        "ARCHITECTURE.md",
        "BUILD.bazel",
        "CODE_OF_CONDUCT.md",
        "CONTRIBUTING.md",
        "Cargo.lock",
        "Cargo.toml",
        "LICENSE",
        "MODULE.bazel",
        "MODULE.bazel.lock",
        "NOTICE",
        "README.md",
        "SECURITY.md",
        "buf.gen.yaml",
        "buf.yaml",
        "component.yaml",
        "flake.lock",
        "flake.nix",
        "go.mod",
        "go.sum",
        "justfile",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "pyproject.toml",
        "rust-toolchain.toml",
        "uv.lock",
        "//docs:documentation",
        "//tools:repository_governance",
    ] + glob(
        [
            ".buildkite/**",
            ".devcontainer/**",
            ".github/**",
            ".vscode/**",
        ],
        exclude = [
            "**/__pycache__/**",
            "**/*.pyc",
            "**/*.pyo",
            "**/.DS_Store",
        ],
    ),
    visibility = ["//visibility:public"],
)

py_test(
    name = "buildkite_pipeline_model_test",
    srcs = [".buildkite/pipeline.py"] + glob([
        ".buildkite/lib/*.py",
        ".buildkite/steps/*.py",
    ]),
    args = ["--check"],
    imports = [
        ".buildkite/lib",
        ".buildkite/steps",
    ],
    legacy_create_init = 0,
    main = ".buildkite/pipeline.py",
    python_version = "PY3",
)

test_suite(
    name = "wave0_tests",
    tests = [
        ":buildkite_pipeline_model_test",
        "//tools:repository_governance_tests",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "wave1_contract_sources",
    srcs = [
        "//protocols:wave1_contract_sources",
        "//tests:wave1_contract_sources",
        "//third_party:wave1_third_party_sources",
        "//tools:wave1_tooling_sources",
    ],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "wave1_contract_tests",
    tests = ["//tests:wave1_contract_tests"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "wave1_sources",
    srcs = [
        ":wave1_contract_sources",
        "//deploy:local_profile",
        "//libs:foundation_sources",
        "//services/control_plane:control_plane_sources",
        "//tests:wave1_contract_sources",
        "//third_party:wave1_third_party_sources",
        "//tools:wave1_tooling_sources",
    ],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "wave1_tests",
    tests = [
        ":wave1_contract_tests",
        "//libs:foundation_tests",
        "//services/control_plane:tests",
        "//tests:artifact_commit_integration_test",
        "//tests:configuration_resolution_test",
        "//tests:control_worker_integration_test",
        "//tests:local_stack_integration_test",
