package(default_visibility = ["//visibility:private"])

exports_files(
    [
        "patches/deep_ep/declared-toolchain-paths.patch",
        "patches/deep_ep/deterministic-version.patch",
        "patches/deep_ep/gin-attestation.patch",
        "patches/deep_ep/runtime-jit-cache.patch",
        "patches/patches.lock.json",
        "source_mirrors/sources.lock.json",
    ],
    visibility = ["//visibility:public"],
)

alias(
    name = "deep_ep_package",
    actual = "//third_party/packages/deep_ep:artifact_bundle",
    visibility = ["//visibility:public"],
)

test_suite(
    name = "test_deep_ep_package_policy",
    tests = ["//third_party/packages/deep_ep:test_package_policy"],
)

filegroup(
    name = "wave1_third_party_sources",
    srcs = [
        "BUILD.bazel",
        "README.md",
        "licenses/README.md",
        "licenses/license_inventory.json",
        "notices/NOTICE.generated.txt",
        "patches/README.md",
        "patches/deep_ep/declared-toolchain-paths.patch",
        "patches/deep_ep/deterministic-version.patch",
        "patches/deep_ep/gin-attestation.patch",
        "patches/deep_ep/runtime-jit-cache.patch",
        "patches/patches.lock.json",
        "source_mirrors/README.md",
        "source_mirrors/sources.lock.json",
        "//third_party/packages/deep_ep:policy_inputs",
    ],
    visibility = ["//visibility:public"],
)
