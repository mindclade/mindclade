{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mindclade.dev/policies/pdb-source-use-approval.v1.schema.json",
  "title": "Mindclade PDB source-use and data-governance approval",
  "description": "Pending-only preactivation contract for SQP-001 PDB source-use approval; approved and revoked states require a future cryptographic verifier.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "mindclade.dev/v1"},
    "kind": {"const": "PDBSourceUseApproval"},
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {"name": {"const": "sqp-001-pdb-source-use"}},
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": [
        "profile",
        "status",
        "productionAuthority",
        "source",
        "requiredApprovers",
        "blockedUntilApproval"
      ],
      "properties": {
        "profile": {"const": "SQP-001"},
        "status": {"const": "pending"},
        "productionAuthority": {"const": false},
        "source": {
          "type": "object",
          "required": ["provider", "releasedOnOrBefore"],
          "properties": {
            "provider": {"const": "PDB"},
            "releasedOnOrBefore": {"const": "2025-12-31T23:59:59Z"}
          },
          "additionalProperties": false
        },
        "requiredApprovers": {
          "const": ["legal", "data-governance", "biological-safety"]
        },
        "blockedUntilApproval": {
          "const": ["pdb-acquisition", "sqp-001-dataset-publication", "wave-2s-implementation"]
        },
        "approvalSubjectRevision": {"$ref": "#/$defs/revision"},
        "sourceTermsUri": {"type": "string", "format": "uri", "minLength": 1},
        "sourceTermsDigest": {"$ref": "#/$defs/digest"},
        "approvedSnapshotManifestDigest": {"$ref": "#/$defs/digest"},
        "allowedPurposes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "restrictedDataClasses": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "retentionPolicy": {"type": "string", "minLength": 1},
        "exportPolicy": {"type": "string", "minLength": 1},
        "safetyEscalationPolicyDigest": {"$ref": "#/$defs/digest"},
        "releaseAuthority": {"type": "string", "minLength": 1},
        "approvals": {
          "type": "array",
          "items": {"$ref": "#/$defs/approval"},
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "allOf": [
            {"contains": {"properties": {"role": {"const": "legal"}}, "required": ["role"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"role": {"const": "data-governance"}}, "required": ["role"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"role": {"const": "biological-safety"}}, "required": ["role"]}, "minContains": 1, "maxContains": 1}
          ]
        },
        "approvalReceiptDigest": {"$ref": "#/$defs/digest"},
        "approvedAt": {"$ref": "#/$defs/utc"},
        "revokedAt": {"$ref": "#/$defs/utc"},
        "revocationReason": {"type": "string", "minLength": 1},
        "revocationReceiptDigest": {"$ref": "#/$defs/digest"}
      },
      "not": {
        "anyOf": [
          {"required": ["approvalSubjectRevision"]},
          {"required": ["sourceTermsUri"]},
          {"required": ["sourceTermsDigest"]},
          {"required": ["approvedSnapshotManifestDigest"]},
          {"required": ["allowedPurposes"]},
          {"required": ["restrictedDataClasses"]},
          {"required": ["retentionPolicy"]},
          {"required": ["exportPolicy"]},
          {"required": ["safetyEscalationPolicyDigest"]},
          {"required": ["releaseAuthority"]},
          {"required": ["approvals"]},
          {"required": ["approvalReceiptDigest"]},
          {"required": ["approvedAt"]},
          {"required": ["revokedAt"]},
          {"required": ["revocationReason"]},
          {"required": ["revocationReceiptDigest"]}
        ]
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "approval": {
      "type": "object",
      "required": ["role", "reviewer", "reviewedAt", "receiptDigest"],
      "properties": {
        "role": {"enum": ["legal", "data-governance", "biological-safety"]},
        "reviewer": {"type": "string", "minLength": 1},
        "reviewedAt": {"$ref": "#/$defs/utc"},
        "receiptDigest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
