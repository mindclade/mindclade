module(
    name = "mindclade",
    version = "0.0.0",
    bazel_compatibility = [
        ">=9.1.1",
        "<=9.1.1",
    ],
)

bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_python", version = "2.3.2")
bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.53.0")
bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "aspect_rules_js", version = "3.4.1")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(
    name = "go_sdk",
    version = "1.26.0",
)
use_repo(go_sdk, "go_sdk")

# The Wave 0 governance suite is Python 3.12 and consumes the root uv.lock
# directly. Bazel therefore owns the interpreter and wheel closure instead of
# inheriting an ambient host Python.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(
    python_version = "3.12",
)
python.toolchain(
    python_version = "3.12",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "mindclade_pypi",
    python_version = "3.12",
    uv_lock = "//:uv.lock",
)
use_repo(pip, "mindclade_pypi")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_dlclark_regexp2",
    "com_github_jackc_pgx_v5",
    "com_github_santhosh_tekuri_jsonschema_v6",
    "com_google_cloud_go_pubsub_v2",
    "com_google_cloud_go_storage",
    "org_golang_google_api",
    "org_golang_google_genproto_googleapis_api",
    "org_golang_google_grpc",
    "org_golang_google_grpc_cmd_protoc_gen_go_grpc",
    "org_golang_google_protobuf",
    "org_golang_x_oauth2",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.97.1"],
)
use_repo(rust, "rust_toolchains")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crate_index",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
)
use_repo(crate, "crate_index")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "npm")

typescript = use_extension("@aspect_rules_ts//ts:extensions.bzl", "typescript")
typescript.deps(version = "5.9.3")
use_repo(typescript, "npm_typescript")

# Nix is the native package authority; Bazel exposes its wheel, manifests,
# SBOM, provenance, and closure as ordinary build artifacts.
deepep_nix = use_extension("//third_party/packages/deep_ep:repository.bzl", "deepep_nix")
use_repo(deepep_nix, "mindclade_deepep_nix")
