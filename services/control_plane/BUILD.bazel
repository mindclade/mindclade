filegroup(
    name = "governed_inputs",
    srcs = [
        "BUILD.bazel",
        "README.md",
        "component.yaml",
        "migrations/000001_kernel.down.sql",
        "migrations/000001_kernel.up.sql",
        "migrations/migration_policy.yaml",
    ],
)

filegroup(
    name = "control_plane_test_sources",
    srcs = [
        "tests/idempotency_test.go",
        "tests/lease_fencing_test.go",
        "tests/tenant_isolation_test.go",
        "tests/transaction_outbox_test.go",
    ],
)

go_test(
    name = "control_plane_test",
    srcs = [":control_plane_test_sources"],
    data = [":governed_inputs"],
    pure = "on",
    visibility = ["//tests:__pkg__"],
    deps = [
        ":artifacts",
        ":inbox",
        ":jobs",
        ":operations",
        ":policies",
        ":queue",
        ":storage",
        "//protocols/generated/go/artifact/v1:bindings",
        "//protocols/generated/go/job/v1:bindings",
        "@com_github_jackc_pgx_v5//stdlib",
    ],
)

test_suite(
    name = "tests",
    tests = [":control_plane_test"],
)

filegroup(
    name = "control_plane_sources",
    srcs = [
        ":artifacts",
        ":audit",
        ":database",
        ":idempotency",
        ":inbox",
        ":jobs",
        ":operations",
        ":outbox",
        ":policies",
        ":queue",
