# The cross-field constraint validators ADR-0025 generates. They are applied in
# one place -- the gRPC unary interceptor, after authorization -- so the library
# is declared beside its only consumer rather than in libs/go: the side-car is
# transitional and the ADR names the trigger that retires it.
go_library(
    name = "validation",
    srcs = ["internal/validation/cross_field.generated.go"],
    importpath = "github.com/mindclade/mindclade/services/control_plane/internal/validation",
    visibility = ["//services/control_plane:__subpackages__"],
    deps = [
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//reflect/protoreflect",
    ],
)

