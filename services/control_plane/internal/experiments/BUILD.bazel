load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//services/control_plane:__subpackages__"])

go_library(
    name = "experiments",
    srcs = [
        "contracts.go",
        "events.go",
        "mapping_sql.go",
        "pagination.go",
        "repository_experiments.go",
        "repository_helpers.go",
        "repository_studies.go",
        "repository_trials.go",
        "server.go",
        "validation.go",
    ],
    importpath = "github.com/mindclade/mindclade/services/control_plane/internal/experiments",
    deps = [
        "//libs/go/audit",
        "//libs/go/numconv",
        "//protocols/generated/go/artifact/v1:bindings",
        "//protocols/generated/go/common/v1:bindings",
        "//protocols/generated/go/experiment/v1:bindings",
        "//protocols/generated/go/internalrpc/experiment/v1:bindings",
        "//services/control_plane:database",
        "//services/control_plane:queue",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//types/known/durationpb",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "experiments_test",
    size = "small",
    srcs = [
        "postgres_integration_test.go",
        "server_test.go",
    ],
    data = [":governed_sources"],
    embed = [":experiments"],
    pure = "on",
    visibility = ["//tests:__pkg__"],
    deps = [
        "//protocols/generated/go/artifact/v1:bindings",
        "//protocols/generated/go/common/v1:bindings",
        "//protocols/generated/go/experiment/v1:bindings",
        "//protocols/generated/go/internalrpc/experiment/v1:bindings",
        "//services/control_plane:database",
        "//services/control_plane:queue",
        "@com_github_jackc_pgx_v5//stdlib",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
        "@org_golang_google_grpc//test/bufconn",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/durationpb",
        "@org_golang_google_protobuf//types/known/fieldmaskpb",
    ],
)

filegroup(
    name = "governed_sources",
    srcs = ["BUILD.bazel"] + glob(["*.go"]),
    visibility = ["//visibility:public"],
)
